pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/Amina0605/projet-Dev0ps.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t mon-app .'
            }
        }

        stage('Run Container') {
            steps {
                sh '''
                docker rm -f mon-app || true
                docker run -d -p 5000:5000 --name mon-app mon-app
                '''
            }
        }

        stage('Test App') {
            steps {
                sh 'curl http://localhost:5000'
            }
        }
    }
}
